# Nome e branding (usare apici singoli per testi, colori o caratteri speciali).
STATS_NAME='Server'
STATS_LABEL='Stats'
STATS_HEADING='Il server, a colpo d’occhio.'
STATS_ACCENT='#63e6b4'
STATS_SECONDARY='#729dff'

# Raccolta e storico in memoria.
STATS_SAMPLE_SECONDS=1
STATS_HISTORY_SECONDS=600
STATS_TIMEZONE=Europe/Rome
# Solo per un database nuovo; le tariffe salvate si cambiano dalla dashboard.
STATS_INITIAL_PRICE=0.30

# HTTP upstream per un reverse proxy HTTPS.
STATS_PORT=8091
BIND_ADDRESS=127.0.0.1
# Generare l’hash con python3 credentials.py prima di avviare il servizio.
STATS_USERNAME=admin
STATS_PASSWORD_HASH=
